
<!DOCTYPE html>
<html lang="en" class="scroll-smooth">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>DJ Picz | Picz Productions</title>
    <!-- Tailwind CSS CDN for rapid, clean styling -->
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        darkbg: '#0a0a0a',
                        cardbg: '#141414',
                        neon: '#00ffcc',
                    }
                }
            }
        }
    </label>
</head>
<body class="bg-darkbg text-gray-100 font-sans antialiased selection:bg-neon selection:text-black">

    <!-- Header / Navbar -->
    <header class="fixed top-0 left-0 w-full z-50 bg-darkbg/90 backdrop-blur-md border-b border-gray-800">
        <div class="max-w-7xl mx-auto px-6 h-20 flex items-center justify-between">
            <a href="#" class="text-2xl font-black tracking-wider uppercase text-white">
                DJ <span class="text-neon">Picz</span>
            </a>
            <nav class="hidden md:flex items-center space-x-8 text-sm font-semibold uppercase tracking-widest">
                <a href="#about" class="hover:text-neon transition">About</a>
                <a href="#music" class="hover:text-neon transition">Music & Mixes</a>
                <a href="#gigs" class="hover:text-neon transition">Events</a>
                <a href="#contact" class="px-5 py-2.5 border border-neon text-neon hover:bg-neon hover:text-black transition duration-300 rounded-none">Bookings</a>
            </nav>
            <!-- Mobile Menu Button -->
            <button id="menu-btn" class="md:hidden text-2xl text-gray-300 focus:outline-none">
                <i class="fa-solid fa-bars"></i>
            </button>
        </div>
        <!-- Mobile Nav Menu -->
        <div id="mobile-menu" class="hidden md:hidden bg-cardbg border-b border-gray-800 px-6 py-4 space-y-3">
            <a href="#about" class="block text-sm uppercase tracking-wider hover:text-neon">About</a>
            <a href="#music" class="block text-sm uppercase tracking-wider hover:text-neon">Music & Mixes</a>
            <a href="#gigs" class="block text-sm uppercase tracking-wider hover:text-neon">Events</a>
            <a href="#contact" class="block text-sm uppercase tracking-wider text-neon">Bookings</a>
        </div>
    </header>

    <!-- Hero Section -->
    <section class="relative h-screen flex items-center justify-center bg-[radial-gradient(ellipse_at_center,_var(--tw-gradient-stops))] from-gray-900 via-darkbg to-black px-6">
        <div class="absolute inset-0 opacity-20 bg-[radial-gradient(#00ffcc_1px,transparent_1px)] [background-size:16px_16px]"></div>
        <div class="relative z-10 text-center max-w-4xl mx-auto">
            <p class="text-neon uppercase tracking-[0.3em] text-sm md:text-base mb-4 font-semibold">Picz Productions Presents</p>
            <h1 class="text-5xl md:text-8xl font-black tracking-tight uppercase mb-6 text-white">
                DJ <span class="text-transparent bg-clip-text bg-gradient-to-r from-neon to-teal-500">Picz</span>
            </h1>
            <p class="text-gray-400 text-lg md:text-xl max-xl mx-auto mb-10 font-light tracking-wide">
                Curating high-energy soundscapes across House, Amapiano, Gqom, and Deep House. Over a decade of turning dancefloors into unforgettable experiences.
            </p>
            <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
                <a href="#music" class="w-full sm:w-auto px-8 py-4 bg-neon text-black font-bold uppercase tracking-wider hover:bg-white transition duration-300">
                    Listen to Mixes
                </a>
                <a href="#contact" class="w-full sm:w-auto px-8 py-4 border border-gray-700 text-white font-bold uppercase tracking-wider hover:border-neon transition duration-300">
                    Get in Touch
                </a>
            </div>
        </div>
    </section>

    <!-- About Section -->
    <section id="about" class="py-24 bg-cardbg border-t border-gray-900">
        <div class="max-w-6xl mx-auto px-6 grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div>
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-6">
                    The Sound & <span class="text-neon">The Experience</span>
                </h2>
                <p class="text-gray-400 leading-relaxed mb-6">
                    With over 10 years of mastery behind the decks, DJ Picz has built a reputation for driving sets that capture the true heartbeat of South African electronic and urban club culture. From deep soulful rhythms to heavy baseline-driven Amapiano and Gqom, every performance is engineered to command the floor.
                </p>
                <p class="text-gray-400 leading-relaxed mb-8">
                    Operating under <strong>Picz Productions</strong>, the focus is simple: precision sound curation, professional crowd engagement, and premium entertainment delivery for clubs, private functions, and major brand activations.
                </p>
                <div class="grid grid-cols-3 gap-6 border-t border-gray-800 pt-6">
                    <div>
                        <span class="block text-3xl font-black text-neon">10+</span>
                        <span class="text-xs uppercase tracking-wider text-gray-500">Years Active</span>
                    </div>
                    <div>
                        <span class="block text-3xl font-black text-neon">4+</span>
                        <span class="text-xs uppercase tracking-wider text-gray-500">Core Genres</span>
                    </div>
                    <div>
                        <span class="block text-3xl font-black text-neon">100%</span>
                        <span class="text-xs uppercase tracking-wider text-gray-500">Floor Energy</span>
                    </div>
                </div>
            </div>
            <div class="relative h-96 bg-gray-900 border border-gray-800 flex items-center justify-center overflow-hidden">
                <!-- Placeholder for DJ Action Photo -->
                <div class="absolute inset-0 bg-gradient-to-tr from-black via-transparent to-neon/10"></div>
                <div class="text-center p-6 z-10">
                    <i class="fa-solid fa-compact-disc text-6xl text-neon mb-4 animate-spin" style="animation-duration: 8s;"></i>
                    <p class="text-sm uppercase tracking-widest text-gray-400">DJ Picz Live in Session</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Music / Mixes Section -->
    <section id="music" class="py-24 max-w-6xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4">Latest Sets & <span class="text-neon">Productions</span></h2>
            <p class="text-gray-400 max-w-xl mx-auto">Stream recent mixes spanning deep house grooves, driving club anthems, and exclusive rhythm selections.</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <!-- Mix Card 1 -->
            <div class="bg-cardbg border border-gray-800 p-6 rounded-none flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs uppercase tracking-widest text-neon bg-neon/10 px-3 py-1">Amapiano / House</span>
                        <span class="text-xs text-gray-500">60 MINS</span>
                    </div>
                    <h3 class="text-xl font-bold uppercase mb-2">Picz Sessions Vol. 1</h3>
                    <p class="text-gray-400 text-sm mb-6">A deep dive into heavy baselines, melodic piano chords, and peak-hour dancefloor energy.</p>
                </div>
                <div class="border-t border-gray-800 pt-4 flex items-center justify-between">
                    <a href="#" class="text-sm uppercase tracking-wider font-bold text-neon hover:underline flex items-center gap-2">
                        <i class="fa-solid fa-play"></i> Listen on SoundCloud
                    </a>
                </div>
            </div>
            <!-- Mix Card 2 -->
            <div class="bg-cardbg border border-gray-800 p-6 rounded-none flex flex-col justify-between">
                <div>
                    <div class="flex items-center justify-between mb-4">
                        <span class="text-xs uppercase tracking-widest text-neon bg-neon/10 px-3 py-1">Deep House / Gqom</span>
                        <span class="text-xs text-gray-500">45 MINS</span>
                    </div>
                    <h3 class="text-xl font-bold uppercase mb-2">The Underground Groove</h3>
                    <p class="text-gray-400 text-sm mb-6">An immersive underground club mix combining hypnotic percussion and driving synthetic rhythms.</p>
                </div>
                <div class="border-t border-gray-800 pt-4 flex items-center justify-between">
                    <a href="#" class="text-sm uppercase tracking-wider font-bold text-neon hover:underline flex items-center gap-2">
                        <i class="fa-solid fa-play"></i> Listen on SoundCloud
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Upcoming Events / Gigs -->
    <section id="gigs" class="py-24 bg-cardbg border-t border-gray-900">
        <div class="max-w-4xl mx-auto px-6">
            <div class="text-center mb-16">
                <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4">Upcoming <span class="text-neon">Dates</span></h2>
                <p class="text-gray-400">Catch DJ Picz live on stage.</p>
            </div>
            <div class="space-y-4">
                <!-- Gig Item -->
                <div class="flex flex-col sm:flex-row items-start sm:items-center justify-between bg-darkbg border border-gray-800 p-6 hover:border-neon transition">
                    <div class="mb-4 sm:mb-0">
                        <span class="text-xs text-neon uppercase tracking-widest font-semibold">Live Set</span>
                        <h4 class="text-lg font-bold uppercase mt-1">Weekend Club Activation</h4>
                        <p class="text-sm text-gray-400">Johannesburg Club Circuit</p>
                    </div>
                    <div class="text-left sm:text-right">
                        <span class="block text-sm font-bold text-white">TBA</span>
                        <span class="text-xs text-gray-500 uppercase tracking-wider">Secure Your Spot</span>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Contact & Bookings Section -->
    <section id="contact" class="py-24 max-w-4xl mx-auto px-6">
        <div class="text-center mb-16">
            <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tight mb-4">Bookings & <span class="text-neon">Inquiries</span></h2>
            <p class="text-gray-400">Get in touch with Picz Productions for artist bookings, corporate collaborations, or private events.</p>
        </div>
        <form class="space-y-6 bg-cardbg border border-gray-800 p-8">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div>
                    <label class="block text-xs uppercase tracking-widest text-gray-400 mb-2">Your Name</label>
                    <input type="text" class="w-full bg-darkbg border border-gray-700 px-4 py-3 text-white focus:outline-none focus:border-neon" placeholder="John Doe" required>
                </div>
                <div>
                    <label class="block text-xs uppercase tracking-widest text-gray-400 mb-2">Email Address</label>
                    <input type="email" class="w-full bg-darkbg border border-gray-700 px-4 py-3 text-white focus:outline-none focus:border-neon" placeholder="john@example.com" required>
                </div>
            </div>
            <div>
                <label class="block text-xs uppercase tracking-widest text-gray-400 mb-2">Event Type / Subject</label>
                <input type="text" class="w-full bg-darkbg border border-gray-700 px-4 py-3 text-white focus:outline-none focus:border-neon" placeholder="Club Booking / Private Event" required>
            </div>
            <div>
                <label class="block text-xs uppercase tracking-widest text-gray-400 mb-2">Message Details</label>
                <textarea rows="5" class="w-full bg-darkbg border border-gray-700 px-4 py-3 text-white focus:outline-none focus:border-neon" placeholder="Date, venue, budget, and performance details..." required></textarea>
            </div>
            <button type="submit" class="w-full py-4 bg-neon text-black font-bold uppercase tracking-wider hover:bg-white transition duration-300">
                Send Booking Inquiry
            </button>
        </form>
    </section>

    <!-- Footer -->
    <footer class="bg-cardbg border-t border-gray-900 py-12 text-center">
        <div class="max-w-6xl mx-auto px-6 flex flex-col md:flex-row items-center justify-between gap-6">
            <p class="text-sm font-bold uppercase tracking-widest text-white">DJ Picz <span class="text-neon">/</span> Picz Productions</p>
            <div class="flex space-x-6 text-gray-400 text-lg">
                <a href="#" class="hover:text-neon transition"><i class="fa-brands fa-instagram"></i></a>
                <a href="#" class="hover:text-neon transition"><i class="fa-brands fa-soundcloud"></i></a>
                <a href="#" class="hover:text-neon transition"><i class="fa-brands fa-facebook"></i></a>
                <a href="#" class="hover:text-neon transition"><i class="fa-brands fa-tiktok"></i></a>
            </div>
            <p class="text-xs text-gray-600 uppercase tracking-wider">&copy; 2026 Picz Productions. All Rights Reserved.</p>
        </div>
    </footer>

    <!-- Mobile Menu Toggle Script -->
    <script>
        const btn = document.getElementById('menu-btn');
        const menu = document.getElementById('mobile-menu');
        btn.addEventListener('click', () => {
            menu.classList.toggle('hidden');
        });
    </script>
</body>
</html>
